<UserControl x:Class="JobFinder.SourceDirectory" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JobFinder">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Visibility="{Binding ShowCatalog, Converter={StaticResource Visible}}">
   <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Margin="16,0,0,0"><TextBlock Text="{Binding Ui[Radius]}" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="RadiusChoice" ItemsSource="{Binding App.Radii}" SelectedItem="{Binding App.Radius, Mode=TwoWay}" MinWidth="110"/></StackPanel><StackPanel><TextBlock Text="{Binding Ui[FindSource]}" FontSize="12" Margin="0,0,0,6"/><Grid><TextBox x:Name="SourceSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Ui[SourceSearchPlaceholder]}" Padding="36,10,34,10" MaxLength="100" AutomationProperties.Name="{Binding Ui[FindSource]}"/><local:FluentIcon Kind="search" Foreground="{DynamicResource TextMuted}" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/><Button Click="ClearSearch" Style="{StaticResource Quiet}" Padding="6" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{Binding Ui[ClearSourceSearch]}" AutomationProperties.Name="{Binding Ui[ClearSourceSearch]}"><local:FluentIcon Kind="dismiss" Width="16" Height="16"/></Button></Grid></StackPanel></DockPanel>
   <WrapPanel Margin="0,0,0,8"><RadioButton Content="{Binding Ui[All]}" IsChecked="{Binding AllKinds}" GroupName="SourceKind" Style="{StaticResource Segment}"/><RadioButton Content="{Binding Ui[Job]}" IsChecked="{Binding Work}" GroupName="SourceKind" Style="{StaticResource Segment}"/><RadioButton Content="{Binding Ui[InternshipShort]}" IsChecked="{Binding Internship}" GroupName="SourceKind" Style="{StaticResource Segment}"/><RadioButton Content="{Binding Ui[Apprenticeship]}" IsChecked="{Binding Training}" GroupName="SourceKind" Style="{StaticResource Segment}"/></WrapPanel>
   <WrapPanel Margin="0,0,0,10"><RadioButton Content="{Binding Ui[AllSources]}" IsChecked="{Binding Both}" GroupName="SourceMode" Style="{StaticResource Segment}"/><RadioButton Content="{Binding Ui[FeedMode]}" IsChecked="{Binding FeedOnly}" GroupName="SourceMode" Style="{StaticResource Segment}"/><RadioButton Content="{Binding Ui[WebsiteMode]}" IsChecked="{Binding PortalOnly}" GroupName="SourceMode" Style="{StaticResource Segment}"/></WrapPanel>
   <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
  </StackPanel>
  <StackPanel x:Name="StatusOverview" Visibility="{Binding IsStatusView, Converter={StaticResource Visible}}" Margin="0,0,0,18">
   <TextBlock Text="{Binding App.SourceStatusTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding App.SourceTone}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding App.SourceBrief}" Foreground="{DynamicResource TextBody}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="{Binding App.HasSourceStatus, Converter={StaticResource Visible}}"/>
   <TextBlock Text="{Binding Ui[FeedLimited]}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding App.HasSourceStatus, Converter={StaticResource Visible}}"/>
   <TextBlock Text="{Binding Ui[SourceSettingsHint]}" Foreground="{DynamicResource WarningText}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="{Binding App.HasSearchChanges, Converter={StaticResource Visible}}"/>
  </StackPanel>
  <ScrollViewer x:Name="DirectoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
   <StackPanel Visibility="{Binding HasFeeds, Converter={StaticResource Visible}}"><WrapPanel Margin="0,2,0,8" Visibility="{Binding ShowCatalog, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Ui[Sources]}" FontSize="17" FontWeight="SemiBold" Margin="0,4,18,0" ToolTip="{Binding Ui[SourcesHint]}"/><Button Content="{Binding Ui[EnableVisibleSources]}" Command="{Binding EnableVisible}" Style="{StaticResource Quiet}" FontSize="12"/><Button Content="{Binding Ui[DisableVisibleSources]}" Command="{Binding DisableVisible}" Style="{StaticResource Quiet}" FontSize="12" Margin="8,0,0,0"/></WrapPanel><ItemsControl x:Name="FeedList" ItemsSource="{Binding Feeds}"/></StackPanel>
   <StackPanel Visibility="{Binding HasPortals, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Ui[WebsiteMode]}" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,5"/><TextBlock Text="{Binding Ui[ExternalHint]}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/><ItemsControl ItemsSource="{Binding Portals}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="0,12" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Categories}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Command="{Binding DataContext.PortalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" ToolTip="{Binding DataContext.Ui[External], RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Name}" Padding="10" VerticalAlignment="Center"><local:FluentIcon Kind="open"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
   <StackPanel Visibility="{Binding ShowCatalog, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Ui[NoSourceMatch]}" Foreground="{DynamicResource TextMuted}" FontSize="16" TextWrapping="Wrap" Margin="0,24,0,0" Visibility="{Binding Empty, Converter={StaticResource Visible}}"/></StackPanel>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{Binding Ui[Close]}" Click="CloseDialog" Padding="18,9" Margin="12,0,0,0" IsCancel="True"/><TextBlock Text="{Binding Ui[SourceSettingsHint]}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>
